# Copy to .env and fill in to enable LIVE mode (real LLM calls).
# Without an API key the studio runs in DEMO mode (simulated agents, real artifacts).

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

HOST=127.0.0.1
PORT=8000
MAX_CONCURRENCY=4
AGENT_MAX_STEPS=8
# WORKSPACE_DIR=./workspace
